[Unit]
Description=Wazuh Indexer
After=wazuh-pod.service

[Container]
Image=docker.io/wazuh/wazuh-indexer:4.14.10
ContainerName=wazuh.indexer
Pod=wazuh.pod
Ulimit=memlock=-1:-1
Ulimit=nofile=65536:65536
Environment=OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
Volume=wazuh-indexer-data:/var/lib/wazuh-indexer
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/root-ca.pem:/usr/share/wazuh-indexer/config/certs/root-ca.pem:z
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/wazuh.indexer-key.pem:/usr/share/wazuh-indexer/config/certs/wazuh.indexer.key:z
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/wazuh.indexer.pem:/usr/share/wazuh-indexer/config/certs/wazuh.indexer.pem:z
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/admin.pem:/usr/share/wazuh-indexer/config/certs/admin.pem:z
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/admin-key.pem:/usr/share/wazuh-indexer/config/certs/admin-key.pem:z
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_indexer/wazuh.indexer.yml:/usr/share/wazuh-indexer/config/opensearch.yml:Z
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_indexer/internal_users.yml:/usr/share/wazuh-indexer/config/opensearch-security/internal_users.yml:Z

[Install]
WantedBy=multi-user.target

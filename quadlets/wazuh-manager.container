
[Unit]
Description=Wazuh Manager
After=wazuh-indexer.service

[Container]
Image=docker.io/wazuh/wazuh-manager:4.14.10
ContainerName=wazuh.manager
Pod=wazuh.pod
Ulimit=memlock=-1:-1
Ulimit=nofile=655360:655360
Environment=INDEXER_URL=https://wazuh.indexer:9200
Environment=INDEXER_USERNAME=<Username>
Environment=INDEXER_PASSWORD=<Password>
Environment=FILEBEAT_SSL_VERIFICATION_MODE=full
Environment=SSL_CERTIFICATE_AUTHORITIES=/etc/ssl/root-ca.pem
Environment=SSL_CERTIFICATE=/etc/ssl/filebeat.pem
Environment=SSL_KEY=/etc/ssl/filebeat.key
Environment=API_USERNAME=<Username>
Environment=API_PASSWORD=<Password>
Volume=wazuh-api-configuration:/var/ossec/api/configuration
Volume=wazuh-etc:/var/ossec/etc
Volume=wazuh-logs:/var/ossec/logs
Volume=wazuh-queue:/var/ossec/queue
Volume=wazuh-var-multigroups:/var/ossec/var/multigroups
Volume=wazuh-integrations:/var/ossec/integrations
Volume=wazuh-active-response:/var/ossec/active-response/bin
Volume=wazuh-agentless:/var/ossec/agentless
Volume=wazuh-wodles:/var/ossec/wodles
Volume=filebeat-etc:/etc/filebeat
Volume=filebeat-var:/var/lib/filebeat
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/root-ca-manager.pem:/etc/ssl/root-ca.pem:z
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/wazuh.manager.pem:/etc/ssl/filebeat.pem:z
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/wazuh.manager-key.pem:/etc/ssl/filebeat.key:z
Volume=/opt/wazuh/wazuh-docker/single-node/config/wazuh_cluster/wazuh_manager.conf:/wazuh-config-mount/etc/ossec.conf:Z

[Install]
WantedBy=multi-user.target

